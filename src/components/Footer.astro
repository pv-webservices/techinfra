---
import { company, nav, services, servicePath, sectors, whatsapp, mailto } from '../data/site';
import Icon from './Icon.astro';
---
<footer class="footer">
  <div class="container footer__main">
    <div class="footer__brand">
      <a class="footer__logo" href="/" aria-label="Techinfra home"><img src="/media/techinfra-logo-hd.webp" width="576" height="246" alt="Techinfra Integrated Solutions Pvt. Ltd." loading="lazy"/></a>
      <p class="footer__name">{company.display}</p>
      <p>{company.tagline}</p>
      <a class="footer__wa" href={whatsapp()} target="_blank" rel="noopener"><Icon name="whatsapp" size={20}/>Enquire on WhatsApp</a>
    </div>
    <div class="footer__col">
      <h2>Quick Links</h2>
      <ul>{nav.map(([label, href]) => <li><a href={href}>{label}</a></li>)}</ul>
    </div>
    <div class="footer__col">
      <h2>Our Services</h2>
      <ul>{services.map((s) => <li><a href={servicePath(s)}>{s.name}</a></li>)}</ul>
    </div>
    <div class="footer__col">
      <h2>Sectors</h2>
      <ul>{sectors.map((s) => <li><a href={'/sectors/#' + s.slug}>{s.name}</a></li>)}</ul>
    </div>
    <div class="footer__col footer__contact">
      <h2>Get in Touch</h2>
      <a href={'tel:' + company.dial}><span><Icon name="phone" size={17}/></span><span class="num">{company.phone}</span></a>
      <a href={mailto()}><span><Icon name="mail" size={17}/></span>{company.email}</a>
      <a href="/contact-us/"><span><Icon name="send" size={17}/></span>Send an enquiry</a>
    </div>
  </div>
  <div class="container footer__bottom">
    <span>© {new Date().getFullYear()} {company.display} All rights reserved.</span>
    <div><a href="/privacy-policy/">Privacy Policy</a><a href="/terms-and-conditions/">Terms &amp; Conditions</a></div>
  </div>
</footer>
