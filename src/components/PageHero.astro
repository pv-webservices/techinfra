---
import Icon from './Icon.astro';
import Img from './Img.astro';
interface Props { title:string; text:string; image?:string; mosaic?:string[]; crumbs:string[][]; tag:string; accent?:string; portrait?:boolean }
const { title, text, image, mosaic, crumbs, tag, accent, portrait=false } = Astro.props;
---
<section class:list={['phero', { 'phero--portrait': portrait }]} style={accent ? `--accent:${accent}` : undefined}>
  <div class="phero__grid-bg" aria-hidden="true"></div>
  <div class="container phero__in">
    <div class="phero__copy">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/">Home</a>
        {crumbs.map(([n, p], i) => <><Icon name="next" size={14}/>{i === crumbs.length - 1 ? <span aria-current="page">{n}</span> : <a href={p}>{n}</a>}</>)}
      </nav>
      <p class="eyebrow eyebrow--light">{tag}</p>
      <h1>{title}</h1>
      <p class="phero__lead">{text}</p>
      {Astro.slots.has('default') && <div class="phero__actions"><slot/></div>}
    </div>
    <div class="phero__media">
      {mosaic ? (
        <div class="mosaic">{mosaic.map((m, i) => <div class={'mosaic__cell mosaic__cell--' + i}><Img name={m} sizes="(max-width: 760px) 50vw, 22vw" priority={i < 2}/></div>)}</div>
      ) : image && (
        <div class="phero__frame"><Img name={image} sizes={portrait ? '(max-width: 760px) 100vw, 34vw' : '(max-width: 760px) 100vw, 48vw'} priority/></div>
      )}
    </div>
  </div>
</section>
