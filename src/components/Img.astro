---
// Responsive image for both the original project media (764px + 400px variants)
// and the optimized generated media (640/1024/1536 WebP variants).
import { media } from '../data/site';
interface Props { name:string; sizes?:string; class?:string; priority?:boolean; alt?:string }
const { name, sizes='(max-width: 760px) 100vw, 50vw', class:cls='', priority=false, alt } = Astro.props;
const m = media[name];
if (!m) throw new Error(`Unknown media "${name}"`);
const src = m.kind === 'legacy'
  ? { src:`/media/${name}.webp`, srcset:`/media/${name}-400.webp 400w, /media/${name}.webp 764w`, w:764, h:508 }
  : m.kind === 'portrait'
    ? { src:`/media/${name}-1024.webp`, srcset:`/media/${name}-640.webp 640w, /media/${name}-1024.webp 1024w`, w:1024, h:1536 }
    : { src:`/media/${name}-1024.webp`, srcset:`/media/${name}-640.webp 640w, /media/${name}-1024.webp 1024w, /media/${name}-1536.webp 1536w`, w:1536, h:1024 };
---
<img class={cls} src={src.src} srcset={src.srcset} sizes={sizes} alt={alt ?? m.alt} width={src.w} height={src.h}
  loading={priority ? 'eager' : 'lazy'} decoding={priority ? 'sync' : 'async'} fetchpriority={priority ? 'high' : 'auto'} />
