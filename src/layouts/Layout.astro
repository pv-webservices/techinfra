---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import { company, whatsapp } from '../data/site';
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource-variable/ibm-plex-sans/wght.css';
import displayFont from '@fontsource-variable/archivo/files/archivo-latin-wdth-normal.woff2?url';
import bodyFont from '@fontsource-variable/ibm-plex-sans/files/ibm-plex-sans-latin-wght-normal.woff2?url';
import '../styles/global.css';
interface Props { title:string; description:string; image?:string; crumbs?:string[][]; service?:string; error?:boolean; preload?:{ href:string; srcset?:string; sizes?:string; media?:string }[] }
const { title, description, image='hero-dusk-1536', crumbs=[], service, error=false, preload=[] } = Astro.props;
const absolute = (p:string) => Astro.site ? new URL(p, Astro.site).href : undefined;
const url = error ? undefined : absolute(Astro.url.pathname);
const ogImage = '/media/' + image + '.webp';
const org = { '@type':'Organization', name:company.name, telephone:company.dial, email:company.email, url:absolute('/'), logo:absolute('/media/techinfra-logo-hd.webp') };
const graph: object[] = [org];
if (Astro.url.pathname === '/') graph.push({ '@type':'WebSite', name:'Techinfra', url });
if (service) graph.push({ '@type':'Service', name:service, provider:org, url, description });
if (crumbs.length && Astro.site) graph.push({ '@type':'BreadcrumbList', itemListElement:[['Home','/'], ...crumbs].map(([name, path], i) => ({ '@type':'ListItem', position:i + 1, name, item:absolute(path) })) });
---
<!doctype html>
<html lang="en-IN">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"/>
  <meta name="theme-color" content="#071d3b"/>
  <link rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin="anonymous"/>
  <link rel="preload" href={bodyFont} as="font" type="font/woff2" crossorigin="anonymous"/>
  {preload.map((p) => <link rel="preload" as="image" href={p.href} imagesrcset={p.srcset} imagesizes={p.sizes} media={p.media} fetchpriority="high"/>)}
  <script is:inline>
    (function(){var d=document.documentElement;d.classList.add('js');
      try{if(sessionStorage.getItem('ti-visited'))d.classList.add('no-loader');sessionStorage.setItem('ti-visited','1');}catch(e){d.classList.add('no-loader');}
    })();
  </script>
  <title>{title}</title>
  <meta name="description" content={description}/>
  {url && <link rel="canonical" href={url}/>}
  <meta property="og:type" content="website"/><meta property="og:site_name" content="Techinfra"/>
  <meta property="og:title" content={title}/><meta property="og:description" content={description}/>
  {url && <meta property="og:url" content={url}/>}
  <meta property="og:image" content={absolute(ogImage) || ogImage}/><meta name="twitter:card" content="summary_large_image"/>
  {error && <meta name="robots" content="noindex"/>}
  <link rel="icon" href="/favicon.ico"/>
  <script type="application/ld+json" set:html={JSON.stringify({ '@context':'https://schema.org', '@graph':graph })}/>
</head>
<body>
  <div class="loader" aria-hidden="true">
    <div class="loader__in"><img src="/media/techinfra-logo-hd.webp" width="576" height="246" alt=""/><span class="loader__bar"></span></div>
  </div>
  <a href="#main" class="skip">Skip to content</a>
  <Header/>
  <main id="main"><slot/></main>
  <Footer/>
  <div class="fab-stack">
    <a class="wa-fab call-fab" href={'tel:' + company.dial} aria-label={'Call Techinfra on ' + company.phone}>
      <span class="wa-fab__icon"><Icon name="phone" size={26}/></span>
      <span class="wa-fab__label">Call us</span>
    </a>
    <a class="wa-fab" href={whatsapp()} target="_blank" rel="noopener" aria-label="Chat with Techinfra on WhatsApp">
      <span class="wa-fab__icon"><Icon name="whatsapp" size={30}/></span>
      <span class="wa-fab__label">Chat with us</span>
    </a>
  </div>
  <script>
    import { initSite } from '../scripts/site';
    initSite();
  </script>
</body>
</html>
